---
import { ArrowRight, Check, MoveRight } from '@lucide/astro';
import { bookingHref, isExternalBookingHref } from '@/utils/booking';
const {
  eyebrow, title, intro, price, price_suffix, image, image_alt, primary_label, primary_href,
  secondary_label, secondary_href, section_title, section_copy, topics, related_href, related_label
} = Astro.props;
const primaryCtaHref = bookingHref(primary_href);
---
<main>
  <section class="page-hero service-hero">
    <div class="shell service-hero-grid">
      <div class="page-hero-copy">
        <p class="eyebrow" data-editable="text" data-prop="eyebrow">{eyebrow}</p>
        <h1 data-editable="text" data-prop="title">{title}</h1>
        <p class="lede" data-editable="text" data-prop="intro">{intro}</p>
        <div class="hero-actions">
          <a class="button" href={primaryCtaHref} target={isExternalBookingHref(primary_href) ? '_blank' : undefined} rel={isExternalBookingHref(primary_href) ? 'noopener noreferrer' : undefined}><editable-text data-prop="primary_label">{primary_label}</editable-text> <ArrowRight size={19} stroke-width={1.8} aria-hidden="true" /></a>
          <a class="text-link" href={secondary_href}><editable-text data-prop="secondary_label">{secondary_label}</editable-text> <MoveRight size={18} stroke-width={1.8} aria-hidden="true" /></a>
        </div>
      </div>
      <figure class="service-hero-media">
        <img src={image} alt={image_alt} width="1536" height="1024" loading="eager" fetchpriority="high" data-editable="image" data-prop-src="image" data-prop-alt="image_alt" />
        {price && <figcaption><span data-editable="text" data-prop="price">{price}</span> <editable-text data-prop="price_suffix">{price_suffix}</editable-text></figcaption>}
      </figure>
    </div>
  </section>

  <section class="content-section">
    <div class="shell narrow-stack">
      <h2 data-editable="text" data-prop="section_title">{section_title}</h2>
      <p data-editable="text" data-prop="section_copy">{section_copy}</p>
      <div class="topic-grid" data-editable="array" data-prop="topics">
        {topics.map((topic: any) => (
          <article class="topic-item" data-editable="array-item">
            <Check size={22} stroke-width={1.8} aria-hidden="true" />
            <div><h3 data-editable="text" data-prop="title">{topic.title}</h3><p data-editable="text" data-prop="copy">{topic.copy}</p></div>
          </article>
        ))}
      </div>
      <a class="related-link" href={related_href}><editable-text data-prop="related_label">{related_label}</editable-text> <ArrowRight size={18} stroke-width={1.8} aria-hidden="true" /></a>
    </div>
  </section>
</main>
