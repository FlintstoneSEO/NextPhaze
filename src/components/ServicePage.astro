---
import { ArrowRight, Check, MoveRight } from '@lucide/astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  price?: string;
  image: string;
  imageAlt: string;
  topics: Array<{ title: string; copy: string }>;
  relatedHref: string;
  relatedLabel: string;
}

const { eyebrow, title, intro, price, image, imageAlt, topics, relatedHref, relatedLabel } = Astro.props;
---

<main>
  <section class="page-hero service-hero">
    <div class="shell service-hero-grid">
      <div class="page-hero-copy">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="lede">{intro}</p>
        <div class="hero-actions">
          <a class="button" href="/book-training/">Book Training <ArrowRight size={19} stroke-width={1.8} aria-hidden="true" /></a>
          <a class="text-link" href="/training/">Explore Training <MoveRight size={18} stroke-width={1.8} aria-hidden="true" /></a>
        </div>
      </div>
      <figure class="service-hero-media">
        <img src={image} alt={imageAlt} width="1536" height="1024" loading="eager" fetchpriority="high" />
        {price && <figcaption><span>{price}</span> per session</figcaption>}
      </figure>
    </div>
  </section>

  <section class="content-section">
    <div class="shell narrow-stack">
      <h2>What the work can include</h2>
      <p>Each session focuses on the training format and development area you select. Exact scheduling, duration, and eligibility will be confirmed through booking.</p>
      <div class="topic-grid">
        {topics.map((topic) => (
          <article class="topic-item">
            <Check size={22} stroke-width={1.8} aria-hidden="true" />
            <div><h3>{topic.title}</h3><p>{topic.copy}</p></div>
          </article>
        ))}
      </div>
      <a class="related-link" href={relatedHref}>{relatedLabel} <ArrowRight size={18} stroke-width={1.8} aria-hidden="true" /></a>
    </div>
  </section>
</main>
