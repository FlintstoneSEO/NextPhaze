---
import { ArrowUpRight } from '@lucide/astro';
const { footer_copy, footer_navigation, contact_name, contact_email, contact_phone } = Astro.props;
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <img class="footer-logo" src="/images/nextphaze-logo-transparent.png" width="512" height="512" alt="" aria-hidden="true" />
      <p data-editable="text" data-prop="footer_copy">{footer_copy}</p>
    </div>
    <nav aria-label="Footer navigation" data-editable="array" data-prop="footer_navigation">
      {footer_navigation.map((item: any) => <a href={item.href} data-editable="array-item"><editable-text data-prop="label">{item.label}</editable-text></a>)}
    </nav>
    <address class="footer-contact">
      <p class="footer-contact-heading">Contact</p>
      <p data-editable="text" data-prop="contact_name">{contact_name}</p>
      <a href={`mailto:${contact_email}`} data-editable="text" data-prop="contact_email">{contact_email}</a>
      <a href={`tel:${contact_phone.replace(/[^0-9+]/g, '')}`} data-editable="text" data-prop="contact_phone">{contact_phone}</a>
    </address>
    <div class="footer-legal">
      <p>© {new Date().getFullYear()} NextPhaze Athletic Training</p>
      <a href="https://www.flintstoneseo.com/" target="_blank" rel="noopener noreferrer">
        Design by Flintstone SEO <ArrowUpRight size={15} stroke-width={1.8} aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>
