---
import { ExternalLink } from '@lucide/astro';
const { eyebrow, title, date, link_label, link_href } = Astro.props;
---
<section class="performance-callout" aria-labelledby="performance-title"><div class="shell performance-grid">
  <div><p data-editable="text" data-prop="eyebrow">{eyebrow}</p><h2 id="performance-title" data-editable="text" data-prop="title">{title}</h2><span data-editable="text" data-prop="date">{date}</span></div><a class="text-link" href={link_href} target="_blank" rel="noopener noreferrer"><editable-text data-prop="link_label">{link_label}</editable-text> <ExternalLink size={17} stroke-width={1.8} aria-hidden="true" /></a>
</div></section>
