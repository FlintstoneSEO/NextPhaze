---
import { ArrowRight } from '@lucide/astro';
import { site } from '@/data/site';
import HomeFocusAreas from '@/components/shared/HomeFocusAreas.astro';
const { title, copy, image, image_alt, featured_title, featured_copy, featured_href } = Astro.props;
---
<section class="content-section training-focus" aria-labelledby="focus-title"><div class="shell">
  <div class="section-heading"><h2 id="focus-title" data-editable="text" data-prop="title">{title}</h2><p data-editable="text" data-prop="copy">{copy}</p></div>
  <div class="focus-layout"><figure class="focus-image"><img src={image} width="1536" height="1024" alt={image_alt} loading="lazy" data-editable="image" data-prop-src="image" data-prop-alt="image_alt" /></figure><div class="focus-list">
    <editable-component data-component="home_focus_areas" data-prop="@data[site]"><HomeFocusAreas {...site} /></editable-component>
    <a href={featured_href}><span class="focus-number" aria-hidden="true">03</span><div><h3 data-editable="text" data-prop="featured_title">{featured_title}</h3><p data-editable="text" data-prop="featured_copy">{featured_copy}</p></div><ArrowRight size={20} stroke-width={1.8} aria-hidden="true" /></a>
  </div></div>
</div></section>
