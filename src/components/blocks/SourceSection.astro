---
import { ExternalLink } from '@lucide/astro';
const { title, copy, links } = Astro.props;
---
<section class="source-section" aria-labelledby="sources-title"><div class="shell source-grid">
  <div><h2 id="sources-title" data-editable="text" data-prop="title">{title}</h2><p data-editable="text" data-prop="copy">{copy}</p></div><div class="source-links" data-editable="array" data-prop="links">{links.map((link: any) => <a href={link.href} target="_blank" rel="noopener noreferrer" data-editable="array-item"><editable-text data-prop="label">{link.label}</editable-text> <ExternalLink size={17} stroke-width={1.8} aria-hidden="true" /></a>)}</div>
</div></section>
