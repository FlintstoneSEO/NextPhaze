---
import { ArrowRight } from '@lucide/astro';
import { bookingHref, isExternalBookingHref } from '@/utils/booking';
const { eyebrow, title, copy, button_label, button_href, image, image_alt } = Astro.props;
const buttonHref = bookingHref(button_href);
---
<section class="page-hero coach-hero"><div class="shell coach-hero-grid">
  <div class="page-hero-copy"><p class="eyebrow" data-editable="text" data-prop="eyebrow">{eyebrow}</p><h1 data-editable="text" data-prop="title">{title}</h1><p class="lede" data-editable="text" data-prop="copy">{copy}</p><a class="button" href={buttonHref} target={isExternalBookingHref(button_href) ? '_blank' : undefined} rel={isExternalBookingHref(button_href) ? 'noopener noreferrer' : undefined}><editable-text data-prop="button_label">{button_label}</editable-text> <ArrowRight size={19} stroke-width={1.8} aria-hidden="true" /></a></div>
  <figure class="coach-portrait">
    <img src={image} alt={image_alt} width="550" height="671" fetchpriority="high" decoding="async" data-editable="image" data-prop="image" />
  </figure>
</div></section>
