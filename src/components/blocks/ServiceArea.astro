---
import { Check } from '@lucide/astro';
const { title, copy, note } = Astro.props;
---
<section class="service-area" id="service-area" aria-labelledby="service-title"><div class="shell service-area-inner">
  <div><h2 id="service-title" data-editable="text" data-prop="title">{title}</h2><p data-editable="text" data-prop="copy">{copy}</p></div><div class="service-note"><Check size={22} stroke-width={1.8} aria-hidden="true" /><p data-editable="text" data-prop="note">{note}</p></div>
</div></section>
