---
const { title, copy } = Astro.props;
---
<section class="service-area" id="service-area" aria-labelledby="service-title"><div class="shell service-area-inner">
  <div><h2 id="service-title" data-editable="text" data-prop="title">{title}</h2><p data-editable="text" data-prop="copy">{copy}</p></div>
</div></section>
