---
import { ArrowRight } from '@lucide/astro';
import { bookingHref, isExternalBookingHref } from '@/utils/booking';
const { title, copy, label, href } = Astro.props;
const ctaHref = bookingHref(href);
---
<section class="cta-band" aria-labelledby="booking-cta-title"><div class="shell cta-band-inner">
  <div><h2 id="booking-cta-title" data-editable="text" data-prop="title">{title}</h2><p data-editable="text" data-prop="copy">{copy}</p></div><a class="button" href={ctaHref} target={isExternalBookingHref(href) ? '_blank' : undefined} rel={isExternalBookingHref(href) ? 'noopener noreferrer' : undefined}><editable-text data-prop="label">{label}</editable-text> <ArrowRight size={19} stroke-width={1.8} aria-hidden="true" /></a>
</div></section>
