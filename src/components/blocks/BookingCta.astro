---
import { ArrowRight } from '@lucide/astro';
const { title, copy, label, href } = Astro.props;
---
<section class="cta-band" aria-labelledby="booking-cta-title"><div class="shell cta-band-inner">
  <div><h2 id="booking-cta-title" data-editable="text" data-prop="title">{title}</h2><p data-editable="text" data-prop="copy">{copy}</p></div><a class="button" href={href}><editable-text data-prop="label">{label}</editable-text> <ArrowRight size={19} stroke-width={1.8} aria-hidden="true" /></a>
</div></section>
