---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
import { buildSeoGraph } from '@/utils/seo';
import '@/styles/global.css';

type Breadcrumb = { name: string; path: string };

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  preloadImage?: string;
  breadcrumbs?: Breadcrumb[];
  noindex?: boolean;
}

const { title, description, canonicalPath = Astro.url.pathname, preloadImage, breadcrumbs = [], noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(canonicalPath, Astro.site) : undefined;
const productionDomainConfigured = Boolean(import.meta.env.SITE_URL);
const baseUrl = Astro.site ?? new URL('http://localhost:4321');
const socialImage = new URL(preloadImage || '/images/nextphaze-logo.png', baseUrl);
const schema = buildSeoGraph({ baseUrl, canonicalUrl: canonical ?? new URL(canonicalPath, baseUrl), pageTitle: title, pageDescription: description, breadcrumbs });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#12110f" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" />}
    <meta name="description" content={description} />
    {(!productionDomainConfigured || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/images/nextphaze-logo.png" />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <editable-component data-component="site_header" data-prop="@data[site]">
      <Header {...site} />
    </editable-component>
    <div id="main-content"><slot /></div>
    <editable-component data-component="site_footer" data-prop="@data[site]">
      <Footer {...site} />
    </editable-component>
    <script>
      if (window.inEditorMode) {
        import('../cloudcannon/registerComponents').catch((error) => {
          console.warn('Failed to load CloudCannon component registration:', error);
        });
      }
    </script>
  </body>
</html>
