---
import { ArrowRight, ExternalLink, Trophy } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BookingCTA from '@/components/BookingCTA.astro';
---

<BaseLayout title="Coach Carrington Thompson | NextPhaze Nashville" description="Meet NextPhaze coach Carrington Thompson, former Western Michigan #15, MAC Champion and professional indoor football champion.">
  <main>
    <section class="page-hero coach-hero">
      <div class="shell coach-hero-grid">
        <div class="page-hero-copy">
          <p class="eyebrow">Coach Carrington Thompson</p>
          <h1>Playing experience turned toward athlete development.</h1>
          <p class="lede">Carrington brings a verified collegiate and professional indoor football background to training in Nashville.</p>
          <a class="button" href="/book-training/">Book Training <ArrowRight size={19} stroke-width={1.8} aria-hidden="true" /></a>
        </div>
        <div class="coach-mark" aria-hidden="true">
          <span>15</span>
          <p>Western Michigan</p>
        </div>
      </div>
    </section>

    <section class="career-stats" aria-labelledby="career-title">
      <div class="shell">
        <div class="section-heading">
          <h2 id="career-title">Collegiate production across Northwood and Western Michigan.</h2>
          <p>These totals combine Carrington's verified Northwood and Western Michigan records.</p>
        </div>
        <div class="stat-grid">
          <div><strong>139</strong><span>Receptions</span></div>
          <div><strong>1,936</strong><span>Receiving yards</span></div>
          <div><strong>18</strong><span>Receiving touchdowns</span></div>
        </div>
      </div>
    </section>

    <section class="content-section career-story" aria-labelledby="story-title">
      <div class="shell career-story-grid">
        <div>
          <Trophy size={34} stroke-width={1.5} aria-hidden="true" />
          <h2 id="story-title">A path built through every phase.</h2>
          <p>From Houston to Northwood, Western Michigan, a championship season, and professional indoor football, Carrington's path reflects continued development.</p>
        </div>
        <ol class="career-timeline">
          <li><strong>Northwood University</strong><span>89 receptions, 1,210 yards, and 10 touchdowns according to his official WMU biography.</span></li>
          <li><strong>Western Michigan</strong><span>#15 wide receiver with 50 receptions, 726 yards, and eight touchdowns across 2015 and 2016.</span></li>
          <li><strong>2016 Championship Season</strong><span>MAC Champion and member of Western Michigan's Cotton Bowl team.</span></li>
          <li><strong>West Michigan Ironmen</strong><span>Professional indoor and arena football experience, 2018 MPIF Champion, and 2018 MPIF Offensive Rookie of the Year.</span></li>
          <li><strong>NextPhaze</strong><span>Experience applied to athlete development through group and one-on-one training in Nashville.</span></li>
        </ol>
      </div>
    </section>

    <section class="performance-callout" aria-labelledby="performance-title">
      <div class="shell performance-grid">
        <div><p>Career performance vs. Eastern Michigan</p><h2 id="performance-title">Eight catches. 177 yards. Two touchdowns.</h2><span>October 22, 2016</span></div>
        <a class="text-link" href="https://wmubroncos.com/news/2016/10/22/football-no-20-wmu-keeps-perfect-record-in-tact-fights-past-emu.aspx" target="_blank" rel="noopener noreferrer">Read the official recap <ExternalLink size={17} stroke-width={1.8} aria-hidden="true" /></a>
      </div>
    </section>

    <section class="source-section" aria-labelledby="sources-title">
      <div class="shell source-grid">
        <div><h2 id="sources-title">Verified source material.</h2><p>External coverage is linked without copying third-party photography.</p></div>
        <div class="source-links">
          <a href="https://wmubroncos.com/sports/football/roster/carrington-thompson/4346" target="_blank" rel="noopener noreferrer">Official WMU player biography <ExternalLink size={17} stroke-width={1.8} aria-hidden="true" /></a>
          <a href="https://wmubroncos.com/sports/football/stats/2016" target="_blank" rel="noopener noreferrer">Western Michigan 2016 statistics <ExternalLink size={17} stroke-width={1.8} aria-hidden="true" /></a>
          <a href="https://localsportsjournal.com/2018/04/ironmen-hold-off-late-midway-rally-win-mpif-championship-game-68-44/" target="_blank" rel="noopener noreferrer">2018 Ironmen championship coverage <ExternalLink size={17} stroke-width={1.8} aria-hidden="true" /></a>
        </div>
      </div>
    </section>
    <BookingCTA title="Bring experience into the work." />
  </main>
</BaseLayout>
