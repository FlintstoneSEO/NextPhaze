---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const page = await getEntry('legal', 'privacy');
if (!page) throw new Error('Missing privacy content.');
const { Content } = await render(page);
---

<BaseLayout title={`${page.data.title} | NextPhaze`} description={page.data.description}>
  <main class="legal-page">
    <div class="shell legal-shell">
      <p class="eyebrow">Privacy</p>
      <h1 data-editable="text" data-prop="title">{page.data.title}</h1>
      <p class="lede" data-editable="text" data-prop="effective_date">Effective {page.data.effective_date}</p>
      <article data-editable="text" data-type="block" data-prop="@content"><Content /></article>
    </div>
  </main>
</BaseLayout>
