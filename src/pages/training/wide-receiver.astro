---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServicePage from '@/components/ServicePage.astro';
import BookingCTA from '@/components/BookingCTA.astro';
---
<BaseLayout title="Wide Receiver Training Nashville, TN | NextPhaze" description="Train receiver footwork, releases, route running and position-specific skills in Nashville with former Western Michigan WR Carrington Thompson.">
  <ServicePage eyebrow="Receiver Skills" title="Wide Receiver Training Built for the Position" intro="Train stance, releases, route detail, catching, and position movement with an experienced receiver." image="/images/receiver-catch.webp" imageAlt="AI-generated close view of an anonymous athlete securing a football catch" topics={[
    { title: 'Stance and start', copy: 'Build a repeatable starting position and an efficient first movement.' },
    { title: 'Release footwork', copy: 'Work through position-specific footwork for creating and protecting space.' },
    { title: 'Route detail', copy: 'Train body control, break mechanics, and the shape of the route.' },
    { title: 'Catching', copy: 'Reinforce hand position, tracking, and securing the football through the catch.' }
  ]} relatedHref="/coach-carrington/" relatedLabel="Meet Coach Carrington" />
  <BookingCTA title="Train the details of the position." />
</BaseLayout>
