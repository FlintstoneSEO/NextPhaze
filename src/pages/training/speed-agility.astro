---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServicePage from '@/components/ServicePage.astro';
import BookingCTA from '@/components/BookingCTA.astro';
---
<BaseLayout title="Speed & Agility Training Nashville, TN | NextPhaze" description="Build better movement, acceleration, footwork and change of direction with speed and agility training from NextPhaze in Nashville.">
  <ServicePage eyebrow="Speed and Agility" title="Speed and Agility Training for Game Movement" intro="Train acceleration, footwork, body control, and change of direction with a clear connection to sport." image="/images/training-lane.webp" imageAlt="AI-generated agility ladder and training cones on an outdoor field" topics={[
    { title: 'Acceleration', copy: 'Work on body position, intent, and early movement mechanics.' },
    { title: 'Footwork', copy: 'Build controlled foot placement through focused patterns and repetitions.' },
    { title: 'Change of direction', copy: 'Train deceleration, re-positioning, and movement into the next action.' },
    { title: 'Game transfer', copy: 'Connect athletic movement to the demands that appear during play.' }
  ]} relatedHref="/training/wide-receiver/" relatedLabel="Explore Wide Receiver Training" />
  <BookingCTA title="Move with more purpose." />
</BaseLayout>
