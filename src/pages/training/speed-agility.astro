---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServicePage from '@/components/ServicePage.astro';
import BookingCTA from '@/components/BookingCTA.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('focus_areas', 'speed-agility');
if (!page) throw new Error('Missing speed and agility content.');
const content = page.data;
---
<BaseLayout title={content.title} description={content.description}>
  <ServicePage eyebrow={content.eyebrow} title={content.title} intro={content.intro} price={content.price ?? undefined} image={content.image} imageAlt={content.image_alt} topics={content.topics} relatedHref={content.related_href} relatedLabel={content.related_label} editable />
  <BookingCTA title="Move with more purpose." />
</BaseLayout>
