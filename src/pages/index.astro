---
import { ArrowRight, Check, MoveRight, Target, Timer, Route, Trophy } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BookingCTA from '@/components/BookingCTA.astro';
import { focusAreas, trainingOptions } from '@/data/site';
---

<BaseLayout
  title="Athletic Training in Nashville, TN | NextPhaze"
  description="Train for speed, agility, football skills and athletic development with NextPhaze in Nashville. Group training is $30 and 1-on-1 training is $60."
  preloadImage="/images/carrington-action-hero.webp"
>
  <main>
    <section class="home-hero">
      <img class="hero-image" src="/images/carrington-action-hero.webp" width="971" height="640" alt="" aria-hidden="true" fetchpriority="high" />
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="shell home-hero-inner">
        <div class="home-hero-copy">
          <p class="eyebrow">Nashville Athletic Training</p>
          <h1>Athletic Training Built for Your Next Phase</h1>
          <p>Build speed, agility, football skill, and disciplined movement with focused coaching in Nashville.</p>
          <div class="hero-actions">
            <a class="button" href="/book-training/">Book Training <ArrowRight size={19} stroke-width={1.8} aria-hidden="true" /></a>
            <a class="button button-secondary" href="/training/">View Training</a>
          </div>
        </div>
      </div>
    </section>

    <section class="pricing-rail" id="pricing" aria-labelledby="pricing-title">
      <div class="shell pricing-grid">
        <div class="pricing-intro">
          <p class="eyebrow">Clear Session Pricing</p>
          <h2 id="pricing-title">Choose your format.</h2>
        </div>
        {trainingOptions.map((option) => (
          <a class="price-option" href={option.href}>
            <span>{option.name}</span>
            <strong>{option.price}</strong>
            <p>{option.summary}</p>
            <MoveRight size={22} stroke-width={1.8} aria-hidden="true" />
          </a>
        ))}
      </div>
    </section>

    <section class="content-section training-focus" aria-labelledby="focus-title">
      <div class="shell">
        <div class="section-heading">
          <h2 id="focus-title">Train the movement. Apply the skill.</h2>
          <p>NextPhaze connects athletic development with the details that show up when the play starts.</p>
        </div>
        <div class="focus-layout">
          <figure class="focus-image">
            <img src="/images/training-lane.webp" width="1536" height="1024" alt="AI-generated training lane with an agility ladder and gold cones" loading="lazy" />
          </figure>
          <div class="focus-list">
            {focusAreas.map((area, index) => (
              <a href={area.href}>
                <span class="focus-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div><h3>{area.name}</h3><p>{area.summary}</p></div>
                <ArrowRight size={20} stroke-width={1.8} aria-hidden="true" />
              </a>
            ))}
            <a href="/training/one-on-one/">
              <span class="focus-number" aria-hidden="true">03</span>
              <div><h3>Focused Coaching</h3><p>Direct feedback and concentrated work in a one-on-one training format.</p></div>
              <ArrowRight size={20} stroke-width={1.8} aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="process-section" aria-labelledby="process-title">
      <div class="shell process-grid">
        <div class="process-title-block">
          <h2 id="process-title">Purpose in every rep.</h2>
          <p>Training is organized around mechanics, repetition, and application. No invented performance scores. Just clear work and direct coaching.</p>
        </div>
        <div class="process-steps">
          <article><Target size={28} stroke-width={1.6} aria-hidden="true" /><h3>Choose the focus</h3><p>Select the training format and development area that match what you want to work on.</p></article>
          <article><Timer size={28} stroke-width={1.6} aria-hidden="true" /><h3>Build the detail</h3><p>Work through movement and skill with coaching feedback that keeps each rep intentional.</p></article>
          <article><Route size={28} stroke-width={1.6} aria-hidden="true" /><h3>Connect it to play</h3><p>Carry footwork, body control, and position technique into game-relevant movement.</p></article>
        </div>
      </div>
    </section>

    <section class="coach-proof" aria-labelledby="coach-title">
      <div class="shell coach-proof-grid">
        <div class="coach-proof-copy">
          <Trophy size={34} stroke-width={1.5} aria-hidden="true" />
          <h2 id="coach-title">Experience that supports the work.</h2>
          <p>Coach Carrington Thompson brings collegiate and professional indoor football experience to a training offer built around athlete development.</p>
          <a class="text-link" href="/coach-carrington/">Meet Coach Carrington <ArrowRight size={18} stroke-width={1.8} aria-hidden="true" /></a>
        </div>
        <div class="credential-grid">
          <div><strong>#15</strong><span>Western Michigan wide receiver</span></div>
          <div><strong>2016</strong><span>MAC Champion and Cotton Bowl team member</span></div>
          <div><strong>2018</strong><span>MPIF Champion and Offensive Rookie of the Year</span></div>
        </div>
      </div>
    </section>

    <section class="service-area" id="service-area" aria-labelledby="service-title">
      <div class="shell service-area-inner">
        <div>
          <h2 id="service-title">Training in the Nashville area.</h2>
          <p>NextPhaze serves athletes in Nashville, Tennessee. Exact training location and session availability are confirmed during booking.</p>
        </div>
        <div class="service-note"><Check size={22} stroke-width={1.8} aria-hidden="true" /><p>No unverified storefront or fixed facility is claimed.</p></div>
      </div>
    </section>

    <section class="faq-section" aria-labelledby="faq-title">
      <div class="shell faq-grid">
        <h2 id="faq-title">Before you book.</h2>
        <div class="faq-list">
          <details><summary>What training formats are available?</summary><p>NextPhaze offers $30 group training and $60 one-on-one training. Speed, agility, and football skill development can be part of the selected focus.</p></details>
          <details><summary>Where does training happen?</summary><p>Training serves the Nashville area. The exact venue is confirmed through the booking process because a permanent public facility has not been verified.</p></details>
          <details><summary>What ages can book?</summary><p>Age eligibility has not yet been published. Confirm athlete eligibility when Square booking becomes available.</p></details>
          <details><summary>How do I schedule?</summary><p>NextPhaze is preparing a Square booking and payment link. The booking page will connect directly to Square once that URL is available.</p></details>
        </div>
      </div>
    </section>

    <BookingCTA />
  </main>
</BaseLayout>
